# LLM_PROVIDER picks the client: anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# LangSmith. With no key nothing is sent. Runs hold metadata only (counts, ids, models,
# tokens). Turning on content capture also stores de-identified states, prompts and
# responses in LangSmith, which keeps them; leave it off unless you are debugging with
# synthetic data. Do not set LANGSMITH_TRACING: the app turns tracing on itself, through a
# client that drops content, and an ambient setting would bypass that.
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=medical-necessity
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_CAPTURE_CONTENT=false

# Date "now" means when judging durations (e.g. 90 days of methotrexate). Defaults to today.
# Pin it for reproducible runs and evals. Leave commented out rather than empty.
# AS_OF_DATE=2026-09-20

# LLM_PROVIDER picks the client: anthropic | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Logfire. With no token nothing is sent; LOGFIRE_CONSOLE=true prints spans locally.
# Spans hold metadata only (counts, ids, models, tokens). Turning on content capture also
# stores de-identified prompts and responses in Logfire, which keeps them; leave it off
# unless you are debugging with synthetic data.
LOGFIRE_TOKEN=
# LOGFIRE_CONSOLE=true
# LOGFIRE_CAPTURE_LLM_CONTENT=false

# Date "now" means when judging durations (e.g. 90 days of methotrexate). Defaults to today.
# Pin it for reproducible runs and evals. Leave commented out rather than empty.
# AS_OF_DATE=2026-09-20
